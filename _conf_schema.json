{
  "dependencies": {
    "type": "object",
    "description": "基础依赖",
    "hint": "FFmpeg 和 ffprobe 为必需依赖；已加入 PATH 时可留空路径；容器部署时填写容器内路径",
    "items": {
      "ffmpeg_path": {
        "type": "string",
        "description": "FFmpeg 可执行文件路径",
        "default": ""
      },
      "ffprobe_path": {
        "type": "string",
        "description": "ffprobe 可执行文件路径",
        "default": ""
      }
    }
  },
  "model_enhancement": {
    "type": "object",
    "description": "模型与语音",
    "items": {
      "overview_model_enabled": {
        "type": "bool",
        "description": "启用视频看图模型",
        "hint": "开启并选择模型后，概览、回看和实时视觉由该模型看图，主模型接收转述文字。关闭或未选择时直接由主模型看图。",
        "default": false
      },
      "overview_provider_id": {
        "type": "string",
        "description": "视频看图模型",
        "hint": "选择 AstrBot 已配置且支持图片的模型。调用失败直接报错，不自动回退为主模型看图。",
        "default": "",
        "_special": "select_provider",
        "condition": {
          "overview_model_enabled": true
        }
      },
      "asr_enabled": {
        "type": "bool",
        "description": "启用 ASR 语音增强",
        "hint": "开启并选择可用模型后，视频分析与实时视觉会转写视频音轨，用于辅助理解；关闭时不提取音频、不调用 ASR。",
        "default": false
      },
      "asr_provider_id": {
        "type": "string",
        "description": "ASR 语音识别提供商",
        "hint": "选择 AstrBot 已配置的语音识别服务。每段最多 30 秒，时间仅表示片段范围。",
        "default": "",
        "_special": "select_provider_stt",
        "condition": {
          "asr_enabled": true
        }
      }
    }
  },
  "general": {
    "type": "object",
    "description": "通用设置",
    "items": {
      "tool_timeout": {
        "type": "float",
        "description": "单次工具调用总超时（秒）",
        "default": 300
      },
      "max_concurrency": {
        "type": "int",
        "description": "并发处理与子进程数量上限",
        "default": 2
      }
    }
  },
  "video_analysis": {
    "type": "object",
    "description": "视频分析",
    "items": {
      "overview": {
        "type": "object",
        "description": "视频概览",
        "items": {
          "overview_interval": {
            "type": "float",
            "description": "概览默认采样间隔（秒）",
            "default": 4
          },
          "overview_output_mode": {
            "type": "string",
            "description": "概览图片输出模式",
            "options": [
              "frames",
              "grid"
            ],
            "labels": [
              "独立帧",
              "九宫格"
            ],
            "hint": "独立帧逐张输出；九宫格按时间顺序每组最多 9 帧，无损拼接且不额外缩放。仅影响概览，回看仍用独立帧；不保证节省视觉 token。",
            "default": "frames"
          },
          "overview_max_frames": {
            "type": "int",
            "description": "概览总帧数上限",
            "hint": "包含固定、边界和变化帧。超预算增大间隔，不截掉后半段。注意模型自身的图片数量和上下文限制。",
            "default": 200
          },
          "overview_max_edge": {
            "type": "int",
            "description": "概览图片长边上限（像素）",
            "default": 640
          },
          "scene_threshold": {
            "type": "float",
            "description": "场景变化阈值",
            "hint": "0～1，越低越敏感。变化候选不等于语义重要帧。",
            "default": 0.3
          }
        }
      },
      "inspect": {
        "type": "object",
        "description": "详细回看",
        "items": {
          "inspect_max_frames": {
            "type": "int",
            "description": "单次回看帧数上限",
            "default": 8
          },
          "inspect_max_edge": {
            "type": "int",
            "description": "回看默认图片长边（像素）",
            "default": 768
          },
          "inspect_max_calls": {
            "type": "int",
            "description": "单个问题的回看次数上限",
            "hint": "同一问题中所有视频共享次数；参数校验失败返还次数，处理失败或超时仍计入；新消息重新计数。",
            "default": 3
          }
        }
      },
      "video_limits": {
        "type": "object",
        "description": "视频限制",
        "items": {
          "download_max_mb": {
            "type": "int",
            "description": "视频大小上限（MB）",
            "hint": "适用于直接附件和分享视频。附件接收后检查，超限时不处理。",
            "default": 200
          },
          "download_max_duration": {
            "type": "float",
            "description": "视频时长上限（秒）",
            "hint": "适用于直接附件和分享视频，超限时不处理。",
            "default": 1800
          }
        }
      },
      "share_video": {
        "type": "object",
        "description": "分享视频",
        "items": {
          "share_links_enabled": {
            "type": "bool",
            "description": "启用分享链接视频解析",
            "hint": "识别文本、分享卡片和引用中的链接，调用概览时才使用 yt-dlp 下载。",
            "default": true
          },
          "download_cache_max_mb": {
            "type": "int",
            "description": "分享视频缓存容量（MB）",
            "hint": "仅管理通过分享链接下载的视频；空闲时清理，闲置期限沿用 cache_ttl。",
            "default": 1024,
            "condition": {
              "share_links_enabled": true
            }
          },
          "download_cookie_file": {
            "type": "string",
            "description": "yt-dlp Cookie 文件路径",
            "hint": "可选，填写 AstrBot 运行环境中的 Netscape 格式 Cookie 文件路径。抖音公开视频会自动获取匿名访问凭据，通常无需填写；需要登录或触发风控时可尝试配置有效的浏览器 Cookie。",
            "default": "",
            "condition": {
              "share_links_enabled": true
            }
          },
          "download_allow_fake_ip": {
            "type": "bool",
            "description": "兼容本机代理 Fake-IP DNS",
            "hint": "仅在代理使用 198.18.0.0/15 虚拟 DNS 时开启；仍拒绝其他内网地址和直接 Fake-IP 链接。",
            "default": false,
            "condition": {
              "share_links_enabled": true
            }
          }
        }
      },
      "user_quota": {
        "type": "object",
        "description": "使用额度",
        "items": {
          "daily_analysis_limit": {
            "type": "int",
            "description": "普通用户每日分析次数上限",
            "hint": "正整数，默认每天 5 次；按北京时间每天 00:00 重置。同一平台用户跨群聊、私聊共享额度，同一条消息中的概览和回看只计一次。管理员无限制。",
            "default": 5
          }
        }
      },
      "runtime_cache": {
        "type": "object",
        "description": "运行与缓存",
        "items": {
          "max_edge_limit": {
            "type": "int",
            "description": "模型请求单帧图片长边的硬上限（像素）",
            "hint": "限制离线视频概览与回看；实时画面使用独立的实时画面长边上限。九宫格保留各帧尺寸，拼接后不再按此值缩放。",
            "default": 1280
          },
          "video_images_in_history": {
            "type": "bool",
            "description": "保留图片到历史",
            "hint": "仅影响视频分析直传主模型的图片。关闭时图片仅当轮有效；开启后随对话历史保留，谨慎开启。",
            "default": false
          },
          "cache_ttl": {
            "type": "float",
            "description": "图片、转写缓存与会话授权有效期（秒）",
            "default": 3600
          },
          "cache_max_mb": {
            "type": "int",
            "description": "图片与转写缓存容量上限（MB）",
            "hint": "启动及工具空闲时清理过期缓存，超容量时从最旧缓存开始清理；不会删除源视频。",
            "default": 512
          }
        }
      }
    }
  },
  "live": {
    "type": "object",
    "description": "实时视觉",
    "items": {
      "live_enabled": {
        "type": "bool",
        "description": "启用实时视觉",
        "default": true,
        "hint": "管理员使用 /live <来源> <响应模式> <观察指令> 启动，来源为屏幕、摄像头或媒体URL，响应模式为提问、定时或变化；/live end 结束。。"
      },
      "live_buffer_seconds": {
        "type": "float",
        "description": "实时缓冲秒数",
        "default": 60,
        "hint": "最多300秒，同时有帧数和内存上限；不永久保存画面。"
      },
      "live_session_seconds": {
        "type": "float",
        "description": "单次会话有效期（秒）",
        "default": 1800,
        "hint": "到期自动停止，最多4小时；同时最多4个会话。"
      },
      "live_max_analyses": {
        "type": "int",
        "description": "单会话模型分析次数上限",
        "default": 120,
        "hint": "包含后台观察和 live_observe。直传时主模型看图并决定回复或沉默；启用独立看图模型时，主动发言还需一次主模型调用。"
      },
      "live_speech_cooldown": {
        "type": "float",
        "description": "主动发言冷却时间（秒）",
        "default": 15
      },
      "devices": {
        "type": "object",
        "description": "设备设置",
        "items": {
          "live_camera_device": {
            "type": "string",
            "description": "摄像头设备",
            "default": "",
            "hint": "留空自动使用默认设备。Linux如 /dev/video0；Windows为DirectShow名称；macOS为AVFoundation设备索引或名称。"
          },
          "live_audio_device": {
            "type": "string",
            "description": "本机音频设备",
            "default": "",
            "hint": "Linux留空：屏幕来源取默认播放回环、摄像头来源取默认麦克风（需要parec）；Windows填写DirectShow音频设备名称；macOS摄像头来源默认麦克风0，屏幕来源需配置回环设备索引。ASR复用现有配置。"
          }
        }
      },
      "screen": {
        "type": "template_list",
        "description": "屏幕预设",
        "hint": "用于 /live 屏幕。优先清晰截图和变化前后对比，减少重复画面。 每种模式只保留一项，删除后使用该模式的默认预设，可从添加条目恢复。",
        "templates": {
          "demand": {
            "name": "提问",
            "items": {
              "sample_interval": {
                "type": "float",
                "description": "采样间隔（秒）",
                "default": 1.0,
                "hint": "0.2～30秒。采集画面的间隔，不是调用模型的间隔。"
              },
              "max_edge": {
                "type": "int",
                "description": "图片长边上限（像素）",
                "default": 1280,
                "hint": "64～4096。用于本预设的采集和模型输入，保持比例且不放大小图。"
              },
              "max_frames": {
                "type": "int",
                "description": "单次图片数量上限",
                "default": 4,
                "hint": "1～32张。选择代表画面并保留最新画面，不用重复图片凑满数量。"
              },
              "lookback_seconds": {
                "type": "float",
                "description": "取帧时间范围（秒）",
                "default": 0,
                "hint": "0～300秒；0只取最新画面。每次从最近这段时间选择图片，受缓冲保留时长限制；live_observe 可指定本次范围。"
              }
            }
          },
          "interval": {
            "name": "定时",
            "items": {
              "sample_interval": {
                "type": "float",
                "description": "采样间隔（秒）",
                "default": 1.0,
                "hint": "0.2～30秒。采集画面的间隔，不是调用模型的间隔。"
              },
              "max_edge": {
                "type": "int",
                "description": "图片长边上限（像素）",
                "default": 1280,
                "hint": "64～4096。用于本预设的采集和模型输入，保持比例且不放大小图。"
              },
              "max_frames": {
                "type": "int",
                "description": "单次图片数量上限",
                "default": 2,
                "hint": "1～32张。选择代表画面并保留最新画面，不用重复图片凑满数量。"
              },
              "lookback_seconds": {
                "type": "float",
                "description": "取帧时间范围（秒）",
                "default": 10,
                "hint": "0～300秒；0只取最新画面。每次从最近这段时间选择图片，受缓冲保留时长限制；live_observe 可指定本次范围。"
              },
              "observation_interval": {
                "type": "float",
                "description": "观察间隔（秒）",
                "default": 10.0,
                "hint": "0.2～300秒。定时调用模型观察的间隔，是否发言由模型和主动发言设置决定。"
              },
              "proactive": {
                "type": "bool",
                "description": "允许主动发言",
                "default": true,
                "hint": "关闭后仍在后台观察；用户提问时才回答。"
              }
            }
          },
          "change": {
            "name": "变化",
            "items": {
              "sample_interval": {
                "type": "float",
                "description": "采样间隔（秒）",
                "default": 0.5,
                "hint": "0.2～30秒。采集画面的间隔，不是调用模型的间隔。"
              },
              "max_edge": {
                "type": "int",
                "description": "图片长边上限（像素）",
                "default": 1280,
                "hint": "64～4096。用于本预设的采集和模型输入，保持比例且不放大小图。"
              },
              "max_frames": {
                "type": "int",
                "description": "单次图片数量上限",
                "default": 3,
                "hint": "1～32张。选择代表画面并保留最新画面，不用重复图片凑满数量。"
              },
              "lookback_seconds": {
                "type": "float",
                "description": "取帧时间范围（秒）",
                "default": 4,
                "hint": "0～300秒；0只取最新画面。每次从最近这段时间选择图片，受缓冲保留时长限制；live_observe 可指定本次范围。"
              },
              "sensitivity": {
                "type": "string",
                "description": "变化灵敏度",
                "default": "medium",
                "hint": "low低、medium中、high高；只决定是否需要观察，是否回应由模型判断。",
                "options": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "min_analysis_interval": {
                "type": "float",
                "description": "最短观察间隔（秒）",
                "default": 5.0,
                "hint": "0.2～300秒。合并连续变化，限制模型调用频率。"
              }
            }
          }
        },
        "default": [
          {
            "__template_key": "demand",
            "sample_interval": 1.0,
            "max_edge": 1280,
            "max_frames": 4,
            "lookback_seconds": 0
          },
          {
            "__template_key": "interval",
            "sample_interval": 1.0,
            "max_edge": 1280,
            "max_frames": 2,
            "lookback_seconds": 10,
            "observation_interval": 10.0,
            "proactive": true
          },
          {
            "__template_key": "change",
            "sample_interval": 0.5,
            "max_edge": 1280,
            "max_frames": 3,
            "lookback_seconds": 4,
            "sensitivity": "medium",
            "min_analysis_interval": 5.0
          }
        ]
      },
